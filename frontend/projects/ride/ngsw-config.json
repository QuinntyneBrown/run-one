{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.svg",
          "/manifest.webmanifest",
          "/icons/**",
          "/*.css",
          "/*.js",
          "!/provide-diagnostics-*.js",
          "/fonts/**"
        ]
      }
    },
    {
      "name": "diagnostics",
      "installMode": "lazy",
      "resources": {
        "files": ["/provide-diagnostics-*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/courses/**", "/riders/**", "/machines/**"]
      }
    }
  ]
}
