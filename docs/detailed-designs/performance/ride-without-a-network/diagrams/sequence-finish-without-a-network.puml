@startuml
title UML sequence behaviour — Finish without a network
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as rider
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "ClassRideStore" as store
  participant "FinishedRideHolder" as holder
  participant "Angular Router" as router
  participant "ClassDonePage" as done
end box
box "Frontend — Ride app (domain library)" #ECFDF3
  participant "RideTicker" as ticker
  participant "RideRecordStore" as record
end box
box "Device — Browser" #F2F4F7
  database "localStorage" as ls
end box
box "External — Static host" #FFF4E5
  participant "Static host" as host
end box
rider -> store : Start the class, with a network
store -> host : Preload Class Done's chunk with a dynamic import
host --> store : Module, kept by the browser
note over store, host : The network is lost some time later
ticker -> store : Tick: second 1800
store -> store : Read RideTotals, EffortTotals and OnTargetCounter
store -> record : RIDE_RECORD.add(output in whole kJ)
record -> ls : Write telo-ride.record
ls --> record : Written
record --> store : RecordOutcome (L2-135 AC2)
store -> holder : FINISHED_RIDE.set(ClassResult)
store -> router : navigateByUrl("/done")
router -> done : Resolve the preloaded module; no request
done -> holder : peek()
holder --> done : ClassResult
done --> rider : Class Done shows the result, exactly as with a network (L2-135 AC2)
@enduml
