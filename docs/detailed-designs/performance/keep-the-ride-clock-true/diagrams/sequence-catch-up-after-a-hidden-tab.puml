@startuml
title UML sequence behaviour — Catch up after a hidden tab
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as rider
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "ClassRideStore" as store
end box
box "Frontend — Ride app (domain library)" #ECFDF3
  participant "RideTicker" as ticker
  participant "RideClock" as clock
  participant "WorkoutEngine" as engine
  participant "RideTotals" as totals
  participant "OnTargetCounter and EffortTotals" as counters
end box
box "Device — Browser" #F2F4F7
  participant "document and timers" as doc
  participant "performance.now()" as perf
end box
box "Device — Smart bike" #F2F4F7
  participant "Smart bike" as bike
end box
rider -> doc : Switch to another tab at 7:00
doc -> doc : Throttle or delay the ticker's timeout
note over clock, perf : No tick is counted; the monotonic clock keeps running (L2-133 AC1)
rider -> doc : Return to the tab 10 minutes later
doc -> ticker : visibilitychange, visible
ticker -> clock : elapsedMs()
clock -> perf : now()
perf --> clock : Monotonic time
clock --> ticker : 17:00 of ride time
ticker -> engine : Tick: second 1020
engine -> engine : planStateAt(plan, elapsed): the current segment
engine -> bike : Send the current segment's level once
ticker -> store : Tick: second 1020
store -> totals : onRunningSecond(600): the seconds the tab skipped
loop each second the tab skipped
  store -> counters : count(power, that second's PlanState, 1 second)
end
store --> rider : Clock, segment and output within 1 second of a visible tab (L2-133 AC2)
ticker -> doc : Schedule the next whole second
@enduml
