@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Stay smooth on long rides

Person(rider, "Rider", "Rides a smart bike at home")
System_Boundary(telo, "Telo Ride 1") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "The four screens, Web Bluetooth, the protocol and the engine")
  ContainerDb(storage, "Browser storage", "localStorage", "The record and the remembered bike")
}
System_Ext(bike, "Smart bike", "Echelon or FTMS; Bluetooth LE")

Rel(rider, app, "Rides, pauses, leaves and returns")
Rel(bike, app, "Notifications, each overwriting the last reading", "Web Bluetooth")
Rel(app, storage, "Writes the fixed-size record at the finish only", "localStorage")
@enduml
