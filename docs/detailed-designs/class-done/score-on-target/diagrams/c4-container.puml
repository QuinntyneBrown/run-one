@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Score on target

Person(rider, "Rider", "Rides a smart bike at home")
System_Ext(bike, "Smart bike", "Echelon or FTMS; Bluetooth LE")
System_Boundary(telo, "Telo Ride 1") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "The four screens, Web Bluetooth, the protocol and the engine")
}

Rel(rider, app, "Rides the class and reads On target in", "Chrome or Edge")
Rel(bike, app, "Reports the telemetry the rider's power comes from", "Bluetooth LE")
@enduml
