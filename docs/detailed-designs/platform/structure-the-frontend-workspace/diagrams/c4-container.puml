@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Structure the frontend workspace

Person(rider, "Rider", "Rides a smart bike at home")
System_Ext(bike, "Smart bike", "Echelon or FTMS; Bluetooth LE")
System_Ext(youtube, "YouTube", "Privacy-enhanced player for the class video")
System_Ext(host, "Static host", "Serves the app's files over HTTPS")
System_Boundary(telo, "Telo Ride 1") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "The four screens, Web Bluetooth, the protocol and the engine")
  ContainerDb(storage, "Browser storage", "localStorage", "The record and the remembered bike")
}

Rel(rider, app, "Uses", "HTTPS")
Rel(host, app, "Serves the production build of the ride application as", "HTTPS")
Rel(app, bike, "Connects to, from domain/src/bluetooth/ only", "Web Bluetooth")
Rel(app, youtube, "Loads the player from, through the video library", "HTTPS")
Rel(app, storage, "Reads and writes, from domain/src/storage/", "localStorage")
@enduml
