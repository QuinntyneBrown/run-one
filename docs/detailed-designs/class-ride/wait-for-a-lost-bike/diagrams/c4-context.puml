@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Wait for a lost bike

Person(rider, "Rider", "Rides a smart bike at home")
System(telo, "Telo Ride 1", "One class, on the rider's own bike")
System_Ext(bike, "Smart bike", "Echelon or FTMS; Bluetooth LE")
System_Ext(youtube, "YouTube", "Privacy-enhanced player for the class video")

Rel(rider, telo, "Reads the alert and presses Reconnect in")
Rel(rider, bike, "Pedals to wake")
Rel(telo, bike, "Retries, then sends the current level to", "Bluetooth LE")
Rel(telo, youtube, "Pauses the class video while waiting", "IFrame Player API")
@enduml
