@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Show the finish banner

Person(rider, "Rider", "Rides a smart bike at home")
System(telo, "Telo Ride 1", "One class, on the rider's own bike")
System_Ext(bike, "Smart bike", "Echelon or FTMS; Bluetooth LE")
System_Ext(youtube, "YouTube", "Privacy-enhanced player for the class video")

Rel(rider, telo, "Sees Finish! and the ride's output in")
Rel(telo, bike, "Goes on reading power and cadence from", "Bluetooth LE")
Rel(telo, youtube, "Lets the class video play on through", "IFrame Player API")
@enduml
