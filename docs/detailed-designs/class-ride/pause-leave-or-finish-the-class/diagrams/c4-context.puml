@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Pause, leave or finish the class

Person(rider, "Rider", "Rides a smart bike at home")
System(telo, "Telo Ride 1", "One class, on the rider's own bike")
System_Ext(bike, "Smart bike", "Echelon or FTMS; Bluetooth LE")
System_Ext(youtube, "YouTube", "Privacy-enhanced player for the class video")

Rel(rider, telo, "Pauses, leaves or finishes the class in")
Rel(telo, bike, "Stops sending plan levels to", "Bluetooth LE")
Rel(telo, youtube, "Pauses and destroys the class video", "IFrame Player API")
@enduml
