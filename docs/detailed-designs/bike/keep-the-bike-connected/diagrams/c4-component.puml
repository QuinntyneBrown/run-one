@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Keep the bike connected

System_Ext(bike, "Smart bike", "Echelon or FTMS; Bluetooth LE")
ContainerDb(storage, "Browser storage", "localStorage", "The remembered bike")
Container_Boundary(ride, "ride application") {
  Component(classPage, "TheClassPage", "Angular page, new", "Header link with the bike status")
  Component(provide, "provideBikeConnection", "Provider function, exists", "Binds the connection, the ticker, the clock and the store")
}
Container_Boundary(domain, "domain library") {
  Component(conn, "WebBluetoothBikeConnection", "Service in bluetooth/, exists", "Reconnects, detects drops, sends the kept target first")
  Component(recon, "DeviceReconnector", "Class, exists", "One attempt every 3 s; retryNow")
  Component(link, "EchelonLink", "BikeLink, exists", "Owns the keepalive of an Echelon")
  Component(keep, "KeepaliveScheduler", "Class, exists", "Sends F0 A0 01 01 92 when a second has passed")
  Component(ticker, "SecondTicker", "Service in engine/, exists", "Beats once a second while subscribed")
  Component(status, "bikeStatus", "Pure helper, exists, reshaped", "Name, hidden text, action and icon of the link")
  Component(store, "RememberedBikeStore", "Service in storage/, exists", "One JSON record: id and name")
}
Container_Boundary(api, "api library") {
  Component(token, "BIKE_CONNECTION", "Contract and token, exists", "ble, bike, reconnectRemembered, reconnectNow, forgetTarget")
  Component(remToken, "REMEMBERED_BIKE", "Contract and token, exists", "get, save, forget")
  Component(tick, "TICKER and MONOTONIC_TIME", "Contracts and tokens, exist", "A beat each second; a clock that never jumps")
  Component(logger, "APP_LOGGER", "Contract and token", "error(area, error); ConsoleAppLogger writes the line")
}

Rel(provide, conn, "Binds to BIKE_CONNECTION")
Rel(conn, token, "Implements")
Rel(store, remToken, "Implements")
Rel(ticker, tick, "Implements TICKER")
Rel(classPage, token, "Reads ble and bike")
Rel(classPage, status, "Derives the link from")
Rel(conn, recon, "Starts on a drop, stops on disconnect")
Rel(conn, link, "Opens and closes")
Rel(link, keep, "Starts when connected, stops when closed")
Rel(keep, tick, "Subscribes to seconds, reads now")
Rel(conn, logger, "Reports errors as text through")
Rel(store, storage, "Reads and writes telo-ride.bike", "localStorage")
Rel(conn, bike, "getDevices, watchAdvertisements, GATT", "Web Bluetooth")
@enduml
