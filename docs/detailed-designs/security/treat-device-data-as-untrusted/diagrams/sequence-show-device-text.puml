@startuml
title UML sequence behaviour — Show device text
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as rider
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "ConnectBikePage and ConnectBikeStore" as page
end box
box "Frontend — Ride app (components library)" #E0F2FE
  participant "ConnectDevice" as card
end box
box "Frontend — Ride app (domain library)" #ECFDF3
  participant "WebBluetoothBikeConnection" as conn
  participant "bikeIdentity" as identity
  participant "RememberedBikeStore" as store
end box
box "Device — Browser" #F2F4F7
  participant "navigator.bluetooth" as ble
  participant "localStorage" as ls
  participant "console" as console
end box
box "Device — Smart bike" #F2F4F7
  participant "Bike" as bike
end box
rider -> page : Start pairing the bike
page -> conn : requestBike()
conn -> ble : requestDevice(filters)
bike --> ble : Advertise a name, possibly hostile or over 64 characters
ble --> conn : BluetoothDevice with name and id
conn -> identity : bikeIdentity(device.name, device.id)
identity -> identity : Cut the name to 64 characters (L2-129 AC2)
identity --> conn : BikeIdentity
conn --> page : BikeInfo; the bike signal changes
page -> store : save(RememberedBikeRecord: id and name) once paired
store -> ls : setItem with the cut name (L2-129 AC2)
page -> card : Bind name and identifier as inputs
card -> card : Render by interpolation into text nodes (L2-129 AC1)
card --> rider : The name shows as text and nothing runs
opt a Web Bluetooth call fails
  ble --> conn : Reject with an error name and message
  conn -> console : Through LOGGER, one string "bluetooth: name: message", never markup (L2-129 AC1, L2-115)
  conn --> page : BikeConnectionError with a code
  page --> rider : The app's own words for the code (L2-017 AC5)
end
@enduml
