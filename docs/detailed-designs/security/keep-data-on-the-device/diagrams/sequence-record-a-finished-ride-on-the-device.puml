@startuml
title UML sequence behaviour — Record a finished ride on the device
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as rider
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "ClassRideStore" as ride
  participant "ClassDonePage" as done
end box
box "Frontend — Ride app (domain library)" #ECFDF3
  participant "RideRecordStore" as store
end box
box "Device — Browser" #F2F4F7
  participant "localStorage" as ls
  participant "Network stack" as net
end box
rider -> ride : Ride the class to 30:00
ride -> store : add(outputKj) through RIDE_RECORD (L2-168 AC1)
store -> ls : getItem("telo-ride.record"), on first use
ls --> store : Stored record or null
store -> store : Add one to the count, set last, raise best
store -> ls : setItem("telo-ride.record", JSON) (L2-132 AC2)
ls --> store : Written on the device
note over store, net : No fetch, beacon, WebSocket or cookie is used for the ride (L2-132 AC1, AC3)
store --> ride : RecordOutcome
ride -> done : Navigate to /done
done --> rider : Show the output, with no prompt for an account (L2-132 AC1)
@enduml
