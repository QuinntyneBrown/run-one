@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Support screen readers and motion

Person(rider, "Rider", "Rides a smart bike at home")
System(telo, "Telo Ride 1", "One class, on the rider's own bike")
System_Ext(host, "Static host", "Serves the app's files over HTTPS")

Rel(rider, telo, "Uses with a screen reader, in either theme, with or without reduced motion")
Rel(host, telo, "Serves the app's files to", "HTTPS")
@enduml
