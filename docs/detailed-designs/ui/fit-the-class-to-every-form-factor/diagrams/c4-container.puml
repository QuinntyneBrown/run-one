@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Fit The Class to every form factor

Person(rider, "Rider", "Rides a smart bike at home")
System_Ext(host, "Static host", "Serves the app's files over HTTPS")
System_Boundary(telo, "Telo Ride 1") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "The four screens, Web Bluetooth, the protocol and the engine")
}
Rel(rider, app, "Views The Class at /", "390 x 844 to 1440 x 900 and beyond")
Rel(host, app, "Serves index.html with the viewport meta, and the lazy chunk of The Class to", "HTTPS")
@enduml
