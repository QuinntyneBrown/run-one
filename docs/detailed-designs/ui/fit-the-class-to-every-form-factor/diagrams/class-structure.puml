@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Fit The Class to every form factor

class TheClassPage <<component>> {
  selector: wz-the-class-page
  .the-class-page: height 100dvh
}
class TheClass <<component>> {
  selector: wz-the-class
  #go: TemplateRef
}
class "the-class.scss" as Sheet <<stylesheet>> {
  .the-class
  .the-class~__scroll
  .the-class~__body
  .the-class~__media
  .the-class~__video
  .the-class~__info
  .the-class~__facts
  .the-class~__length
  .the-class~__stats
  .the-class~__plan
  .the-class~__action
  .the-class~__footer
  .the-class~__start
}
class "Below lg" as Narrow <<media query>> {
  default rules
  .the-class~__body: one column
  .the-class~__scroll: overflow-y auto
  .the-class~__footer: shown, a flex sibling of the scroll body
  .the-class~__action: display none
  .the-class~__stats: flex 1 1 16rem, wraps under the length
}
class "From lg" as Wide <<media query>> {
  @media (min-width: 64rem)
  .the-class~__body: minmax(0, 1fr) and the aside, min-height 100%
  .the-class~__body rows: minmax(160 px, 1fr) and auto
  .the-class~__scroll: scrolls only where the aside cannot fit
  .the-class~__media: container-type size
  .the-class~__video: width min(100cqw, 100cqh x 16 / 9)
  .the-class~__action: display block
  .the-class~__footer: display none
}
class "Short window from lg" as Short <<media query>> {
  @media (min-width: 64rem) and (max-height: 49.99rem)
  .the-class~__body: padding-block 16 px
  .the-class~__title: one step smaller
  margins above the summary, Ride with, the facts,
  the record and the start button: smaller
}
class "tokens.css" as Tokens <<stylesheet>> {
  --the-class-aside-width: 380 px
  --the-class-aside-width-xl: 420 px
  --layout-margin
  --layout-container-max: 1280 px
}
class "index.html" as Index <<config>> {
  meta viewport: width=device-width, initial-scale=1, viewport-fit=cover
}
class Button {
  +variant: ButtonVariant
  +size: ButtonSize
  +block: boolean
}

TheClassPage --> TheClass : the height under the header
TheClass ..> Sheet : styleUrl
TheClass --> "2" Button : one template, two outlets
Sheet *-- Narrow
Sheet *-- Wide
Sheet *-- Short
Sheet ..> Tokens : reads
Narrow ..> Index : env(safe-area-inset-bottom)
@enduml
